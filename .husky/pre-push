# Pushing a PR branch publishes a Netlify deploy preview, and whatever
# reaches main goes to production with the next release train cut, so this
# gate is the last thing between a broken build and a live URL. Worth the
# seconds.

npx tsc --noEmit || exit 1
npm run tokens:check || exit 1

# Tests block the push. CI no longer runs them on PRs (Actions minutes), so
# this hook is where they run; the suite is green on main, so a failure here
# is this change's. Never bypass it with --no-verify.
if node -e "process.exit(require('./package.json').scripts['test:ratchet'] ? 0 : 1)" 2>/dev/null; then
  npm run test:ratchet || exit 1
else
  npm test || exit 1
fi
